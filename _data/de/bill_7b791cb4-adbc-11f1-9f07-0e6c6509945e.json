{"legislative_session": "153", "identifier": "HB 438", "title": "AN ACT TO AMEND TITLE 19 OF THE DELAWARE CODE RELATING TO SERVICE LETTERS, CHILD-CARE FACILITIES, AND HEALTH-CARE FACILITIES.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act adds the definition of child-serving entity for the purpose of requiring a service letter verification from any child-serving entity where an employee may have worked. \u201cChild-serving entity\u201d is already defined in \u00a7 309 of Title 31 and includes DSCYF, residential child-care facilities, public and private schools, youth camps, summer schools, and other entities.  If a previous employer fails to respond to a service letter, this Act also requires that the prospective employee report the failure to respond to the DOL."}], "other_titles": [{"note": "short title", "title": "Service Letter Verification/Child-Serving Entity"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb438"}], "actions": [{"description": "Introduced and Assigned to Labor Committee in House", "date": "2026-05-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Labor", "entity_type": "organization", "organization_id": null}]}, {"description": "Re-Assigned to Administration Committee in House", "date": "2026-06-11", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Administration) in House with 5 On Its Merits", "date": "2026-06-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}, 