{"legislative_session": "153", "identifier": "SR 24", "title": "DESIGNATING JUNE 28, 2026, AS \u201cSTONEWALL UPRISING REMEMBRANCE DAY\u201d IN THE STATE OF DELAWARE.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["resolution"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This resolution affirms the importance of recognizing the history, contributions, and resilience of LGBTQIA+ individuals and designates June 28, 2026, as \u201cStonewall Uprising Remembrance Day\u201d in the State of Delaware. It also recognizes the historical significance of the Stonewall uprising in advancing LGBTQIA+ civil rights and encourages continued efforts to ensure Delaware residents are informed about the importance of acceptance of, and equitable treatment for, LGBTQIA+ individuals, as well as the preservation and accurate interpretation of LGBTQIA+ history."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-sr24"}], "actions": [{"description": "Introduced in Senate", "date": "2026-06-18", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction"], "related_entities": []}, {"description": "Passed By Senate. Votes: 21 YES", "date": "2026-06-18", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["passage"], "related_entities": []}], "sponsorships": [{"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "Bill Text", "links": [{"url": "https://legis.delaware.gov/json/BillDetail/GenerateHtmlDocument?legislationId=143531&legislationTypeId=2&docTypeId=2&legislationName=SR24", "media_type": "text/html"}, {"url": "https://legis.delaware.gov/json/BillDetail/GeneratePdfDocument?legislationId=143531&legislationTypeId=2&docTypeId=2&legislationName=SR24", "media_type": "application/pdf"}], 