{"legislative_session": "153", "identifier": "HB 218", "title": "AN ACT TO AMEND TITLE 10 OF THE DELAWARE CODE RELATING TO INTERPERSONAL AND SEXUAL VIOLENCE IN THE MILITARY.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act requires that the court consider the existence of a military protective order as a factor in favor of granting an emergency protective order or a temporary sexual violence protective order. It further requires that a law-enforcement officer notify the agency that entered a military protective order against an individual, if the law-enforcement officer has probable cause to believe that the individual violated the military protective order."}], "other_titles": [{"note": "short title", "title": "Military Protective Order/State Court Consideration"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb218"}], "actions": [{"description": "was introduced and adopted in lieu of HB 218", "date": "2026-06-12", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "Passed By House. Votes: 38 YES 3 ABSENT", "date": "2026-06-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Judiciary Committee in Senate", "date": "2026-06-16", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Judiciary) in Senate with 4 On Its Merits", "date": "2026-06-24", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By Senate. V