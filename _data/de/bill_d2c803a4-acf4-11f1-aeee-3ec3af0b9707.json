{"legislative_session": "153", "identifier": "HB 299", "title": "AN ACT TO AMEND TITLE 18 OF THE DELAWARE CODE RELATING TO LIFE INSURANCE POLICY EXCLUSIONS AND RESTRICTIONS BASED ON DEATH RESULTING FROM SUICIDE.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "Current Delaware law provides that a life insurance policy may contain a provision excluding or restricting coverage in the event of death by suicide within 2 years from the date of issue of the policy. This Act reduces the time period to 1 year from the date of issue of the policy.  It applies to a policy that is issued after the effective date of the Act.\r\nThis Act also requires that in the event any death benefit is denied because the insured dies as a result of suicide within 1 year from the date of issue of the policy, the insurer must refund all premiums paid for coverage providing the denied death benefit on the insured.  \r\nThis Act is effective 6 months after its enactment into law."}], "other_titles": [{"note": "short title", "title": "Life Insurance Policy/Suicide/Update Provision"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb299"}], "actions": [{"description": "Introduced and Assigned to Economic Development/Banking/Insurance & Commerce Committee in House", "date": "2026-03-05", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Economic Development/Banking/Insurance & Commerce", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Economic Development/Banking/Insurance & Commerce) in House with 2 Favorable, 8 On Its Merits", "date": "2026-03-24", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Economic Development/Banking/Insurance & Commerce", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By House. Votes: 36 YES 5 ABSENT", "date": "2026-04-23", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Banking, Business, Insurance & Technology Committee in Senate", "date": "2026-04-23", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Banking, Business, Insurance & Technology", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Banking, Business, Insurance & Technology) in Senate with 3 Favorable, 4 On Its Merits", "date": "2026-06-10", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Banking, Business, Insurance & Technology", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By Senate. Votes: 20 YES 1 ABSENT", "date": "2026-06-16", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["passage"], "related_entities": []}], "sponsorships": [{"name": "Eric Morrison", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Eric Morrison\"}", "organization_id": null}, {"name": "Spiros Mantzavinos", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Spiros Mantzavinos\"}", "organization_id": null}, {"name": "Marie Pinkney", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Marie Pinkney\"}", "organization_id": null}, {"name": "Bryant L. Richardson", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"