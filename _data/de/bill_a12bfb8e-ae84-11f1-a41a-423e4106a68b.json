{"legislative_session": "153", "identifier": "HB 321", "title": "AN ACT TO AMEND TITLE 29 OF THE DELAWARE CODE RELATING TO THE PROCEDURE FOR DISSEMINATION TO THE PUBLIC OF A PROPOSED AMENDMENT TO THE DELAWARE CONSTITUTION.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act amends the procedure for disseminating to the public a proposed amendment to the Delaware Constitution by eliminating the requirement that the dissemination through publication in a newspaper. \r\n\r\nRemoving this requirement is expected to result in cost savings for the State, while still requiring the posting on state websites to ensure continued public accessibility."}], "other_titles": [{"note": "short title", "title": "Eliminate Newspaper Publication on Const. Amendments"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb321"}], "actions": [{"description": "Introduced and Assigned to Administration Committee in House", "date": "2026-03-11", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Administration) in House with 5 On Its Merits", "date": "2026-04-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Administration", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By House. Votes: 37 YES 1 NO 3 ABSENT", "date": "2026-04-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Executive Committee in Senate", "date": "2026-04-21", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"n