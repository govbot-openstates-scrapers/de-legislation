{"legislative_session": "153", "identifier": "SB 246", "title": "AN ACT TO AMEND TITLE 14 OF THE DELAWARE CODE RELATING TO DRIVER EDUCATION CERTIFICATION.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act updates how academic eligibility for driver education certification is calculated because many high schools have moved from the traditional 7-period school day to various forms of block scheduling. Under this Act, the Department of Education must establish, through regulations, how equivalent credit is calculated for courses taught on a block schedule or when the full length of a course is less than 1 year. This Act also adds world language to the academic courses from which a student may satisfy the credit requirement.\r\n\r\nThis Act also makes technical corrections to conform existing law to the standards of the Delaware Legislative Drafting Manual."}], "other_titles": [{"note": "short title", "title": "Driver Education/Certification/Eligibility/Updates"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-sb246"}], "actions": [{"description": "Introduced and Assigned to Education Committee in Senate", "date": "2026-03-05", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Education) in Senate with 5 On Its Merits", "date": "2026-03-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Amendment SA 1 to SB 246 - Introduced and Placed With Bill", "date": "2026-03-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["amendment-introduction"], "related_entities