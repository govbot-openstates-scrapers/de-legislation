{"legislative_session": "153", "identifier": "HB 326", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO THEFT BY IMPERSONATION OF A FAMILY MEMBER.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act increases the penalty when an individual commits theft by impersonating a family member of the victim.  A person convicted of a violation of this section shall be imprisoned for not less than 60 days. The minimum sentence under this section may not be suspended."}], "other_titles": [{"note": "short title", "title": "Theft by Impersonation of a Family Member/Penalty"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb326"}], "actions": [{"description": "Introduced and Assigned to Judiciary Committee in House", "date": "2026-03-18", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Judiciary) in House with 7 On Its Merits", "date": "2026-04-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Amendment HA 1 to HB 326 - Introduced and Placed With Bill", "date": "2026-04-16", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-introduction"], "related_entities": []}, {"description": "Amendment HA 1 to HB 326 - Passed In House by Voice Vote", "date": "2026-05-05", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage"], "related_entities": []}, {"description": "Passed By House. Votes: 33 YES 2 NO 6 ABSENT", "date": "2026-05-05", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["pa