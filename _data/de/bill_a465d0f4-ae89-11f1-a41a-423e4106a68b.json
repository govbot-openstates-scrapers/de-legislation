{"legislative_session": "153", "identifier": "SB 179", "title": "AN ACT TO AMEND TITLE 11 OF THE DELAWARE CODE RELATING TO THE DELAWARE SENTENCING GUIDELINES AND ACCOUNTABILITY COMMISSION.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act repeals Subchapter X of Title 11 which established the Delaware Sentencing Accountability Commission (Commission) and recodifies the Commission under Chapter 89A of Title 11. \r\n\r\nThis Act modernizes the Commission\u2019s mission, establishes the membership of the Commission, codifies the Commission\u2019s overall power and authority, and creates a duty for the Commission to provide a data report annually."}], "other_titles": [{"note": "short title", "title": "Delaware Sentencing Accountability Commission/Modernize"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-sb179"}], "actions": [{"description": "Introduced and Assigned to Judiciary Committee in Senate", "date": "2025-06-05", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Judiciary) in Senate with 5 On Its Merits", "date": "2025-06-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Judiciary", "entity_type": "organization", "organization_id": null}]}, {"description": "Assigned to Finance Committee in Senate", "date": "2025-06-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Finance", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Finance) in Senate with 4 On Its Merits", "date": "2026-01-14", "organization_id": "~{\"c