{"legislative_session": "153", "identifier": "SJR 20", "title": "DIRECTING THE DIVISION OF MEDICAID AND MEDICAL ASSISTANCE TO EVALUATE ASSESSMENTS FOR INDIVIDUALS RECEIVING HOME AND COMMUNITY-BASED SERVICES.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["joint resolution"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This resolution requires the Department of Health & Social Services to evaluate the feasibility of using independent assessment tools and assessors for the determination of support needs for individuals eligible for Home and Community-Based Services in the State. The Department shall present a report to the Delaware General Assembly, by March 1, 2027, on its findings."}], "other_titles": [{"note": "short title", "title": "DHSS/Assessment/HCBS"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-sjr20"}], "actions": [{"description": "Introduced and Assigned to Executive Committee in Senate", "date": "2026-06-09", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Executive", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Executive) in Senate with 7 On Its Merits", "date": "2026-06-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Executive", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By Senate. Votes: 20 YES 1 ABSENT", "date": "2026-06-11", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Health & Human Development Committee in House", "date": "2026-06-11", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Health & Human Development", "entity_type": "o