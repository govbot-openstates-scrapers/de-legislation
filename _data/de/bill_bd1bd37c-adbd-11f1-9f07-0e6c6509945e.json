{"legislative_session": "153", "identifier": "HB 267", "title": "AN ACT TO AMEND TITLE 14 OF THE DELAWARE CODE RELATING TO READING COMPETENCY.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act provides that each school district and charter school must report three times a year, instead of annually, to the Department of Education, the number and percentage of students, disaggregated by grade and by individual school, identified with a potential reading deficiency, including characteristics of dyslexia, pursuant to mandated literary screening, and the literacy intervention approaches being provided."}], "other_titles": [{"note": "short title", "title": "Potential Reading Deficiency/Report/3 Times a Year"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb267"}], "actions": [{"description": "Introduced and Assigned to Education Committee in House", "date": "2026-01-13", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Amendment HA 1 to HB 267 - Introduced and Placed With Bill", "date": "2026-04-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-introduction"], "related_entities": []}, {"description": "Reported Out of Committee (Education) in House with 16 On Its Merits", "date": "2026-04-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Amendment HA 1 to HB 267 - Passed In House by Voice Vote", "date": "2026-05-05", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["amendment-passage"], "related_entities": []}, {"description": "Passed By House. V