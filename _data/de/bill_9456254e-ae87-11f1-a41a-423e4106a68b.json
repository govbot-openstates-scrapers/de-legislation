{"legislative_session": "153", "identifier": "HCR 108", "title": "CELEBRATING DEMEC DAY AND RECOGNIZING THE DELAWARE MUNICIPAL ELECTRIC CORPORATION AND THE COMMUNITY-OWNED NOT FOR PROFIT ELECTRIC UTILITIES THROUGHOUT DELAWARE.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["concurrent resolution"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Concurrent Resolution recognizes the Delaware Municipal Electric Corporation and community-owned, not-for-profit electric utilities throughout Delaware for their dedication to serving communities with programs that save energy and money, as well as renewable projects that lower emissions to benefit the environment. This Resolution also celebrates DEMEC\u2019s upcoming 47th anniversary and over 100 years of reliable and safe electric service from Delaware\u2019s local public power utilities by proclaiming March 25, 2026, as DEMEC Day."}], "other_titles": [], "other_identifiers": [{"identifier": "ocd-bill-de-153-hcr108"}], "actions": [{"description": "Introduced in House", "date": "2026-03-24", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "Passed In House by Voice Vote", "date": "2026-03-24", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_entities": []}, {"description": "Passed By Senate. Votes: 20 YES 1 ABSENT", "date": "2026-03-25", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["passage"], "related_entities": []}], "sponsorships": [{"name": "Mara Gorman", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Mara Gorman\"}", "organization_id": null}, {"name": "Melanie Ross Levin", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"Melanie Ross Levin\"}", "organization_id": nul