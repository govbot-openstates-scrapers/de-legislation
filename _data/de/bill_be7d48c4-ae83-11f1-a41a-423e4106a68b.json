{"legislative_session": "153", "identifier": "HB 429", "title": "AN ACT TO AMEND TITLE 18 OF THE DELAWARE CODE RELATING TO THE STEP THERAPY EXCEPTION PROCESS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act modernizes Delaware law by adding modern medical treatment options biologics or biosimilars to the step therapy exception process. The current law was passed before biosimilars were widely available. Biosimilars are to biologics what generic drugs are to traditional drugs once their exclusivity expires.  \r\nThis revision adds an exclusion to step therapy protocol exceptions for interchangeable biologics and biosimilars."}], "other_titles": [{"note": "short title", "title": "Biologics/Biosimilars/Step Therapy/Updates"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb429"}], "actions": [{"description": "Introduced and Assigned to Economic Development/Banking/Insurance & Commerce Committee in House", "date": "2026-05-19", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Economic Development/Banking/Insurance & Commerce", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Economic Development/Banking/Insurance & Commerce) in House with 3 Favorable, 6 On Its Merits", "date": "2026-06-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Economic Development/Banking/Insurance & Commerce", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By House. Votes: 38 YES 1 NO 2 ABSENT", "date": "2026-06-11", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Banking, Business, Insurance &