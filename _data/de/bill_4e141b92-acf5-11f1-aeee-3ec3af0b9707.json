{"legislative_session": "153", "identifier": "HB 224", "title": "AN ACT TO AMEND TITLE 16 AND TITLE 24 OF THE DELAWARE CODE RELATING TO REGISTRATION OF DEATH.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "The Act authorizes licensed Physician Assistants (PA) in Delaware to pronounce death and to complete a medical certification of death. This Act also removes registered nurses from the list of practitioners who may complete a medical certification of death, as it conflicts with the scope of practice set out in Title 24. \r\n\r\nThis Act also makes technical changes to conform to the Legislative Drafting Manual."}], "other_titles": [{"note": "short title", "title": "Physician Assistants/Pronounce Death/Death Certificate"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb224"}], "actions": [{"description": "Introduced and Assigned to Health & Human Development Committee in House", "date": "2025-06-24", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Health & Human Development", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Health & Human Development) in House with 12 Favorable", "date": "2026-01-14", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Health & Human Development", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By House. Votes: 36 YES 5 ABSENT", "date": "2026-01-15", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Health & Social Services Committee in Senate", "date": "2026-01-15", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introdu