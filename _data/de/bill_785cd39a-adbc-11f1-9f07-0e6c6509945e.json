{"legislative_session": "153", "identifier": "HB 443", "title": "AN ACT TO AMEND TITLE 14 OF THE DELAWARE CODE RELATING TO BACKGROUND CHECKS FOR VOLUNTEERS IN EDUCATION.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act provides clarification that all individuals currently or prospectively serving as mentors to one or more students through a mentoring program under the Department of Education must submit to state and federal criminal background checks, and that they are subject to continued criminal record monitoring for 1 year."}], "other_titles": [{"note": "short title", "title": "DOE/Mentors/Background Checks"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb443"}], "actions": [{"description": "Introduced and Assigned to Education Committee in House", "date": "2026-05-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Education) in House with 10 On Its Merits", "date": "2026-06-17", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By House. Votes: 41 YES", "date": "2026-06-18", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Education Committee in Senate", "date": "2026-06-18", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Education", "entity_type": "organization", "organization_id": null}]}, {"description": "Re-Assigned to Executive Committee in Senate", "date": "2026-06-24", "org