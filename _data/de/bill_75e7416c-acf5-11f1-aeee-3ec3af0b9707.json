{"legislative_session": "153", "identifier": "HB 211", "title": "AN ACT TO AMEND TITLE 29 OF THE DELAWARE CODE RELATING TO THE INNOVATING DELAWARE ACT.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Substitute for House Bill 211 creates the Innovate Delaware Program. This Program allows an Economic Development Organization to apply for a tax credit program through the Division of Small Business. \r\nThis Substitute also lowers the cap on appropriations to support the tax credit program from 10 million to 3 million dollars in a calendar year."}], "other_titles": [{"note": "short title", "title": "Innovate DE Program/Create"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb211"}], "actions": [{"description": "Introduced", "date": "2026-06-30", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction"], "related_entities": []}, {"description": "Out of Committee", "date": "2026-06-30", "organization_id": "~{\"classification\": \"lower\"}", "classification": [], "related_entities": []}], "sponsorships": [{"name": "William Bush", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"lower\", \"name\": \"William Bush\"}", "organization_id": null}, {"name": "Darius J. Brown", "classification": "primary", "entity_type": "person", "primary": true, "person_id": "~{\"chamber\": \"upper\", \"name\": \"Darius J. Brown\"}", "organization_id": null}], "related_bills": [], "versions": [{"note": "Bill Text", "links": [{"url": "https://legis.delaware.gov/json/BillDetail/GenerateHtmlDocument?legislationId=143680&legislationTypeId=6&docTypeId=2&legislationName=HS1forHB211", "media_type": "text/html"}, {"url": "https://legis.delaware.gov/json/BillDetail/GeneratePdfDocument?legislationId=143680&legislationTypeId=6&docTypeId=2&legislationName=HS1forHB211", "media_type": "application/pdf"}], "date