{"legislative_session": "153", "identifier": "SB 67", "title": "AN ACT TO AMEND TITLE 16 OF THE DELAWARE CODE RELATING TO THE BACKGROUND CHECK CENTER.", "from_organization": "~{\"classification\": \"upper\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act is a substitute for Senate Bill No. 67. It differs from the original bill by changing the period of time that a criminal history report obtained by the Background Check Center is valid for 1 year, instead of 3 years. The 1-year period of time is now applicable to both applicants of long-term care facilities as well as home-care agencies. \r\nThis Act also removes the requirement that a current employee of a long-term care facility or home-care agency would need to get another criminal background check if they seek a promotion with their current employer.\r\nBecause this Act codifies the time frame in which a criminal background check is required, this Act removes the administrative discretion previously provided to the Department of Health and Social Services to determine the frequency in which fingerprints must be obtained."}], "other_titles": [{"note": "short title", "title": "Background Check Center/Criminal History Report/Codify"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-sb67"}], "actions": [{"description": "was introduced and adopted in lieu of SB 67", "date": "2025-12-18", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["introduction"], "related_entities": []}, {"description": "Passed By Senate. Votes: 21 YES", "date": "2026-01-29", "organization_id": "~{\"classification\": \"upper\"}", "classification": ["passage"], "related_entities": []}, {"description": "Assigned to Health & Human Development Committee in House", "date": "2026-03-05", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Health & Human Development", "entity