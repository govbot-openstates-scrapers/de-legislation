{"legislative_session": "153", "identifier": "HB 441", "title": "AN ACT TO AMEND TITLE 6 OF THE DELAWARE CODE RELATING TO CRYPTOCURRENCY KIOSKS.", "from_organization": "~{\"classification\": \"lower\"}", "classification": ["bill"], "subject": [], "abstracts": [{"note": "synopsis", "abstract": "This Act prohibits cryptocurrency kiosks and mandates removal of existing cryptocurrency kiosks within 90 days of the effective date of the Act. A violation of the Act is an unlawful practice and prohibited trade practice. This Act also prohibits the circumvention of the kiosk ban through cashier-assisted or point-of-sale cryptocurrency transactions and extends liability to persons who facilitate such transactions or knowingly allow such activity to occur on their premises.  Violators are subject to injunctive relief, a civil penalty not to exceed $10,000, and a private right of action for damages caused by the violation."}], "other_titles": [{"note": "short title", "title": "Cryptocurrency Kiosks/Prohibit"}], "other_identifiers": [{"identifier": "ocd-bill-de-153-hb441"}], "actions": [{"description": "Introduced and Assigned to Economic Development/Banking/Insurance & Commerce Committee in House", "date": "2026-05-21", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["introduction", "referral-committee"], "related_entities": [{"name": "Economic Development/Banking/Insurance & Commerce", "entity_type": "organization", "organization_id": null}]}, {"description": "Reported Out of Committee (Economic Development/Banking/Insurance & Commerce) in House with 1 Favorable, 7 On Its Merits", "date": "2026-06-09", "organization_id": "~{\"classification\": \"lower\"}", "classification": ["committee-passage", "committee-passage-favorable"], "related_entities": [{"name": "Economic Development/Banking/Insurance & Commerce", "entity_type": "organization", "organization_id": null}]}, {"description": "Passed By House. Votes: 40 YES 1 ABSENT", "date": "2026-06-11", "orga